{
  "name": "codesurf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server.js",
    "start": "node --env-file-if-exists=.env.local server.js",
    "test": "node --test",
    "build": "esbuild browser/icons.js --bundle --format=esm --minify --outfile=public/icons.js",
    "runner:build": "docker build -t codesurf-runner:local runner"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide": "^1.55.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
