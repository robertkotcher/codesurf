{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://codesurf.io/releases/1.0.0/tour.schema.json",
  "title": "CodeSurf tour v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "files", "cards", "connections", "steps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "question": {"type": "string", "maxLength": 2000},
    "revision": {"type": "string", "maxLength": 200},
    "files": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/file"}},
    "cards": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/definitions/card"}},
    "connections": {"type": "array", "maxItems": 300, "items": {"$ref": "#/definitions/connection"}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/definitions/step"}}
  },
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 100},
    "line": {"type": "integer", "minimum": 1},
    "range": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/definitions/line"}},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["card", "lines"],
      "properties": {"card": {"$ref": "#/definitions/id"}, "lines": {"$ref": "#/definitions/range"}}
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["card", "line"],
      "properties": {"card": {"$ref": "#/definitions/id"}, "line": {"$ref": "#/definitions/line"}}
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["id", "path", "language", "source"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "path": {"type": "string", "minLength": 1, "maxLength": 1000},
        "language": {"enum": ["ruby", "python", "javascript", "typescript", "json", "bash", "css", "xml", "plaintext"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 500000},
        "startLine": {"$ref": "#/definitions/line"},
        "sourceUrl": {"type": "string", "pattern": "^https://", "maxLength": 2000},
        "revision": {"type": "string", "maxLength": 200}
      }
    },
    "card": {
      "type": "object", "additionalProperties": false, "required": ["id", "file", "title", "range"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "file": {"$ref": "#/definitions/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "range": {"$ref": "#/definitions/range"},
        "relevant": {"type": "array", "maxItems": 100, "items": {"$ref": "#/definitions/range"}},
        "outlines": {"type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false, "required": ["name", "lines"],
          "properties": {"name": {"type": "string", "maxLength": 200}, "lines": {"$ref": "#/definitions/range"}}
        }},
        "diff": {"enum": ["before", "after"]},
        "changedLines": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/definitions/line"}},
        "x": {"type": "integer", "minimum": 0, "maximum": 20000},
        "y": {"type": "integer", "minimum": 0, "maximum": 20000}
      }
    },
    "connection": {
      "type": "object", "additionalProperties": false, "required": ["id", "from", "to", "label", "kind"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "from": {"$ref": "#/definitions/endpoint"}, "to": {"$ref": "#/definitions/endpoint"},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["call", "event", "return", "success", "failure"]}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["title", "explanation", "revealCards", "revealConnections", "focus"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "explanation": {"type": "array", "minItems": 1, "maxItems": 40, "items": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 4000}, "target": {"$ref": "#/definitions/target"}}
        }},
        "revealCards": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
        "revealConnections": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
        "focus": {"$ref": "#/definitions/target"}
      }
    }
  }
}
