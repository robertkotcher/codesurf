    {
      "id": "checkout",
      "path": "demo-shop/checkout.mjs",
      "language": "javascript",
      "source": "import { reserve, release } from \"./inventory.mjs\";\nimport { charge } from \"./payments.mjs\";\n\n// A checkout reserves stock before asking the payment provider to charge.\n// Failed payments return the reserved stock so another customer can buy it.\nexport async function checkout(cart, paymentToken) {\n  const reservation = reserve(cart);\n  try {\n    const receipt = await charge(reservation.total, paymentToken);\n    return { status: \"paid\", reservation, receipt };\n  } catch (error) {\n    release(reservation);\n    throw error;\n  }\n}\n\n// The transport layer supplies a parsed cart and a payment token.\nexport async function handleCheckout(request) {\n  return checkout(request.cart, request.paymentToken);\n}\n"
    },
    {
      "id": "inventory",
      "path": "demo-shop/inventory.mjs",
      "language": "javascript",
      "source": "const stock = new Map([\n  [\"coffee\", { available: 12, price: 500 }],\n  [\"tea\", { available: 8, price: 350 }],\n]);\n\n// Reservations contain integer prices in cents.\nexport function reserve(cart) {\n  if (!cart.length) throw new Error(\"The cart is empty\");\n  const quantities = new Map();\n  for (const { sku, quantity } of cart) {\n    if (!Number.isInteger(quantity) || quantity < 1) {\n      throw new Error(\"Quantity must be a positive integer\");\n    }\n    quantities.set(sku, (quantities.get(sku) || 0) + quantity);\n  }\n  const items = [...quantities].map(([sku, quantity]) => {\n    const item = stock.get(sku);\n    if (!item || quantity > item.available) {\n      throw new Error(\"Not enough stock\");\n    }\n    return { sku, quantity, price: item.price };\n  });\n  for (const { sku, quantity } of items) {\n    stock.get(sku).available -= quantity;\n  }\n  return { items, total: items.reduce((sum, item) => sum + item.price * item.quantity, 0) };\n}\n\nexport function release(reservation) {\n  for (const { sku, quantity } of reservation.items) {\n    stock.get(sku).available += quantity;\n  }\n}\n"
    },
    {
      "id": "payments",
      "path": "demo-shop/payments.mjs",
      "language": "javascript",
      "source": "// A local demo provider. No network request is made.\nexport async function charge(amount, token) {\n  if (token !== \"demo-approved\") {\n    throw new Error(\"Payment declined\");\n  }\n  return { id: \"demo-receipt\", amount };\n}\n"
    }
