{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://runner.codesurf.io/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://runner.codesurf.io/auth/:path*"
    },
    {
      "source": "/runs/:id",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://github.com"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/github/:owner/:repo/pull/:number",
      "destination": "/?pr=https://github.com/:owner/:repo/pull/:number",
      "permanent": false
    }
  ]
}
