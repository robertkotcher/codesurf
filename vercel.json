{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://runner.codesurf.io/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://runner.codesurf.io/auth/:path*"
    },
    {
      "source": "/runs/:id",
      "destination": "/app.html"
    },
    {
      "source": "/review/github/:owner/:repo/pr/:number",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/dlPFq54009w30fM7Olpmmufo+aTb1MrEpuGrGL29e8='; style-src 'self' 'sha256-rhXHsu9Dc9Udws1dxYf3q6tMq9YgoJezARk1sxOzIl0='; img-src 'self' data: blob:; connect-src 'self'; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://github.com; font-src 'self' data:"
        }
      ]
    },
    {
      "source": "/downloads/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/github/:owner/:repo/pull/:number",
      "destination": "/review/github/:owner/:repo/pr/:number",
      "permanent": false
    }
  ]
}
